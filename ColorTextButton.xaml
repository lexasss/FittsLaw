<Button x:Class="FittsLaw.Views.ColorTextButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:FittsLaw.Views"
        xmlns:vm="clr-namespace:FittsLaw.ViewModels"
        xmlns:conv="clr-namespace:FittsLaw.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="72"
        d:DesignWidth="46"
        BorderThickness="1"
        BorderBrush="#FFBBBBBB">
    <Button.Resources>
        <conv:ColorToBrush x:Key="color2brush"/>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
    
    <!--Button.DataContext>
        <vm:ColorToolbarButton />
    </Button.DataContext-->
    
    <StackPanel>
        <Rectangle Fill="{Binding Color}"
                   Width="24"
                   Height="24"
                   Stroke="#FFBBBBBB"
                   StrokeThickness="1"/>
        <Label Content="{Binding Text}"
               HorizontalContentAlignment="Center"/>
    </StackPanel>
</Button>
