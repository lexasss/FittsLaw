<Window x:Class="FittsLaw.Views.Setup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FittsLaw.ViewModels"
        xmlns:helpers="clr-namespace:FittsLaw.Helpers"
        xmlns:conv="clr-namespace:FittsLaw.Converters"
        xmlns:valid="clr-namespace:FittsLaw.Validators"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Setup"
        Width="296"
        Icon="/Assets/Images/icon.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Window.DataContext>
        <vm:Setup />
    </Window.DataContext>
    <Window.Resources>
        <conv:LayoutTypeToVisibility x:Key="LayoutToVisibility"/>
        <ObjectDataProvider x:Key="LayoutTypes"
                            ObjectType="{x:Type sys:Enum}"
                            MethodName="GetValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="helpers:LayoutType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <StackPanel.Resources>
                <Style TargetType="WrapPanel">
                    <Setter Property="Margin" Value="4" />
                </Style>
                <Style TargetType="Label">
                    <Setter Property="Width" Value="130" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Width" Value="140" />
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Width" Value="140" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="2" />
                    <Style.Triggers>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter Property="BorderBrush" Value="Red" />
                            <Setter Property="ToolTip"
                                    Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)/ErrorContent}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Padding" Value="2" />
                </Style>
            </StackPanel.Resources>

            <WrapPanel>
                <Label Content="Number of sessions" />
                <TextBox>
                    <TextBox.Text>
                        <Binding Path="Model.SessionCount"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnNotifyDataErrors="True"
                                 NotifyOnValidationError="True">
                            <Binding.ValidationRules>
                                <valid:IntegerRangeValidationRule
                                    Minimum="1"
                                    Maximum="20" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </WrapPanel>

            <WrapPanel>
                <Label Content="Layout" />
                <ComboBox ItemsSource="{Binding Source={StaticResource LayoutTypes}}"
                          SelectedItem="{Binding Model.LayoutType}" />
            </WrapPanel>

            <WrapPanel Visibility="{Binding Model.LayoutType,
                                    Converter={StaticResource LayoutToVisibility},
                                    ConverterParameter={x:Static helpers:LayoutType.Circular}}">
                <Label Content="Number of targets" />
                <TextBox>
                    <TextBox.Text>
                        <Binding Path="Model.TrialCount"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnNotifyDataErrors="True"
                                 NotifyOnValidationError="True">
                            <Binding.ValidationRules>
                                <valid:IntegerRangeValidationRule
                                    Minimum="3"
                                    Maximum="50" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </WrapPanel>

            <WrapPanel Visibility="{Binding Model.LayoutType,
                                    Converter={StaticResource LayoutToVisibility},
                                    ConverterParameter={x:Static helpers:LayoutType.Circular}}">
                <Label Content="Amplitudes" />
                <TextBox>
                    <TextBox.Text>
                        <Binding Path="Amplitudes"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnNotifyDataErrors="True"
                                 NotifyOnValidationError="True">
                            <Binding.ValidationRules>
                                <valid:NumberArrayValidationRule
                                    Minimum="20"
                                    Maximum="2000"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </WrapPanel>

            <WrapPanel>
                <Label Content="Widths" />
                <TextBox>
                    <TextBox.Text>
                        <Binding Path="Widths"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnNotifyDataErrors="True"
                                 NotifyOnValidationError="True">
                            <Binding.ValidationRules>
                                <valid:NumberArrayValidationRule
                                    Minimum="5"
                                    Maximum="200"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </WrapPanel>

            <WrapPanel Visibility="{Binding Model.LayoutType,
                                    Converter={StaticResource LayoutToVisibility},
                                    ConverterParameter={x:Static helpers:LayoutType.Grid}}">
                <Label Content="Rows and columns" />
                <TextBox Width="50">
                    <TextBox.Text>
                        <Binding Path="Model.GridSize.Height"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnNotifyDataErrors="True"
                                 NotifyOnValidationError="True">
                            <Binding.ValidationRules>
                                <valid:IntegerRangeValidationRule
                                    Minimum="2"
                                    Maximum="10" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <Label Content="x"
                       Width="Auto"
                       Margin="4,0"/>
                <TextBox Width="50">
                    <TextBox.Text>
                        <Binding Path="Model.GridSize.Width"
                                 UpdateSourceTrigger="PropertyChanged"
                                 ValidatesOnNotifyDataErrors="True"
                                 NotifyOnValidationError="True">
                            <Binding.ValidationRules>
                                <valid:IntegerRangeValidationRule
                                    Minimum="2"
                                    Maximum="10" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </WrapPanel>

            <WrapPanel>
                <Label Content="Input" />
                <ComboBox ItemsSource="{Binding InputTypes}"
                          SelectedItem="{Binding Model.InputType}" />
            </WrapPanel>

            <WrapPanel>
                <Label Content="Display" />
                <ComboBox ItemsSource="{Binding Source={x:Static helpers:Displays.Items}}"
                          SelectedIndex="{Binding Model.ScreenIndex}" />
            </WrapPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <WrapPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Margin" Value="2"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="💾"
                            ToolTip="Save into a file"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="📂"
                            ToolTip="Load from a file"
                            Command="{Binding LoadCommand}"/>
                </WrapPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox IsChecked="{Binding Model.IsRandomized}"
                              Content="Randomized"
                              Margin="0,8,0,0"/>
                    <CheckBox IsChecked="{Binding Model.HasAudioFeedback}"
                              Content="Audio feedback"
                              Margin="0,8,0,0"/>
                    <CheckBox IsChecked="{Binding Model.IsDistinctErrorAudioFeedback}"
                              IsEnabled="{Binding Model.HasAudioFeedback}"
                              Content="distinct on errors"
                              Margin="20,4,0,0"/>
                    <CheckBox IsChecked="{Binding Model.IsContinueManually}"
                              Content="Manual continuation"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="80" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5" />
                </Style>
            </WrapPanel.Resources>
            <Button Content="Start"
                    IsDefault="True"
                    Command="{Binding StartCommand}"
                    Click="Start_Click"/>
            <Button Content="Cancel"
                    IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
