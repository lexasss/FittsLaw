<Window x:Class="FittsLaw.Views.Setup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FittsLaw.ViewModels"
        xmlns:helpers="clr-namespace:FittsLaw.Helpers"
        mc:Ignorable="d"
        Title="Setup"
        Width="296"
        Icon="/Assets/Images/icon.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Window.DataContext>
        <vm:Setup />
    </Window.DataContext>
    <Window.Resources>
        <ObjectDataProvider x:Key="Displays"
                            ObjectType="{x:Type helpers:Displays}"
                            MethodName="GetValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="helpers:Displays" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <StackPanel.Resources>
                <Style TargetType="WrapPanel">
                    <Setter Property="Margin" Value="4" />
                </Style>
                <Style TargetType="Label">
                    <Setter Property="Width" Value="130" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Width" Value="140" />
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Width" Value="140" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="2" />
                </Style>
                <Style TargetType="CheckBox">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Padding" Value="2" />
                </Style>
            </StackPanel.Resources>

            <WrapPanel>
                <Label Content="Number of targets" />
                <ComboBox ItemsSource="{Binding TargetCounts}"
                          SelectedItem="{Binding TargetCount}" />
            </WrapPanel>

            <WrapPanel>
                <Label Content="Amplitudes" />
                <TextBox Text="{Binding Amplitudes, Mode=TwoWay}"
                         ToolTip="Space-separated integers" />
            </WrapPanel>

            <WrapPanel>
                <Label Content="Widths" />
                <TextBox Text="{Binding Widths, Mode=TwoWay}"
                         ToolTip="Space-separated integers" />
            </WrapPanel>

            <WrapPanel>
                <Label Content="Input" />
                <ComboBox ItemsSource="{Binding InputTypes}"
                          SelectedItem="{Binding InputType}" />
            </WrapPanel>

            <WrapPanel>
                <Label Content="Display" />
                <ComboBox ItemsSource="{Binding Source={x:Static helpers:Displays.Items}}"
                          SelectedIndex="{Binding DisplayId}" />
            </WrapPanel>

            <WrapPanel>
                <Label Content="" />
                <CheckBox IsChecked="{Binding IsRandomized, Mode=TwoWay}"
                          Content="Randomized"/>
            </WrapPanel>

            <WrapPanel>
                <Label Content="" />
                <StackPanel>
                    <CheckBox IsChecked="{Binding HasAudioFeedback, Mode=TwoWay}"
                              Content="Audio feedback"/>
                    <CheckBox IsChecked="{Binding IsDistinctErrorAudioFeedback, Mode=TwoWay}"
                              IsEnabled="{Binding HasAudioFeedback}"
                              Content="distinct on errors"
                              Margin="20,4,0,0"/>
                </StackPanel>
            </WrapPanel>

            <WrapPanel>
                <Label Content="" />
                <CheckBox IsChecked="{Binding IsContinueManually, Mode=TwoWay}"
                          Content="Manual continuation"/>
            </WrapPanel>
        </StackPanel>

        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Center">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="80" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5" />
                </Style>
            </WrapPanel.Resources>
            <Button Content="Start"
                    IsDefault="True"
                    Command="{Binding StartCommand}"
                    Click="Start_Click"/>
            <Button Content="Cancel"
                    IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
