<Page x:Class="FittsLaw.Views.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ctrl="clr-namespace:FittsLaw.Controls"
      xmlns:vm="clr-namespace:FittsLaw.ViewModels"
      xmlns:conv="clr-namespace:FittsLaw.Converters"
      xmlns:valid="clr-namespace:FittsLaw.Validators"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main"
      Focusable="True"
      Loaded="Page_Loaded">
    <Page.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SetupCommand}"/>
    </Page.InputBindings>

    <Page.Resources>
        <conv:Inverse x:Key="inverse"/>
        <conv:BrushToColor x:Key="brush2color"/>
    </Page.Resources>

    <Grid Background="{Binding Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Style="{StaticResource ToolbarIconButton}"
                        ToolTip="Setup"
                        Command="{Binding SetupCommand}"
                        IsEnabled="{Binding IsExperimentRunning, Converter={StaticResource inverse}}">
                    <StackPanel>
                        <Label Content="☰"
                               FontSize="22"
                               Padding="0"
                               HorizontalAlignment="Center"/>
                        <TextBlock Padding="2,4">Setup</TextBlock>
                    </StackPanel>
                </Button>
            </ToolBar>
            <ToolBar>
                <ctrl:ColorTextButton Color="{Binding Background, Mode=TwoWay, Converter={StaticResource brush2color}}"
                                      Text="Background"
                                      Click="Color_Click"/>
                <ctrl:ColorTextButton Color="{Binding BorderBrush, Mode=TwoWay, Converter={StaticResource brush2color}}"
                                      Text="Target border"
                                      Click="Color_Click"/>
                <ctrl:ColorTextButton Color="{Binding ActiveTargetBrush, Mode=TwoWay, Converter={StaticResource brush2color}}"
                                      Text="Active target"
                                      Click="Color_Click"/>
                <ctrl:ColorTextButton Color="{Binding ActiveTargetBorderBrush, Mode=TwoWay, Converter={StaticResource brush2color}}"
                                      Text="Active border"
                                      Click="Color_Click"/>
                <ctrl:ColorTextButton Color="{Binding CompletedTargetBorderBrush, Mode=TwoWay, Converter={StaticResource brush2color}}"
                                      Text="Completed border"
                                      Click="Color_Click"/>
            </ToolBar>
            <ToolBar>
                <StackPanel VerticalAlignment="Center">
                    <TextBox Width="26"
                             Height="26"
                             Margin="0,4,0,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center">
                        <TextBox.Text>
                            <Binding Path="CriticalErrorRate"
                                     UpdateSourceTrigger="PropertyChanged"
                                     ValidatesOnNotifyDataErrors="True"
                                     NotifyOnValidationError="True">
                                <Binding.ValidationRules>
                                    <valid:DoubleRangeValidationRule
                                        Minimum="0.3"
                                        Maximum="1.0" />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <Trigger Property="Validation.HasError" Value="True">
                                        <Setter Property="BorderBrush" Value="Red" />
                                        <Setter Property="ToolTip"
                                        Value="{Binding RelativeSource={RelativeSource Self},
                                                Path=(Validation.Errors)/ErrorContent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Label>Critical error rate</Label>
                </StackPanel>
            </ToolBar>
        </ToolBarTray>

        <StackPanel Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Label Content="Target preview" 
                   HorizontalAlignment="Center"/>
            <UniformGrid Columns="3" Rows="2">
                <UniformGrid.Resources>
                    <Style TargetType="Ellipse">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Margin" Value="8"/>
                        <Setter Property="Stroke" Value="{Binding BorderBrush, Mode=OneWay}"/>
                    </Style>
                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                </UniformGrid.Resources>

                <Ellipse Stroke="{Binding BorderBrush, Mode=OneWay}"
                         Fill="{Binding Background, Mode=OneWay}"
                         ToolTip="Initial"/>
                <Ellipse Stroke="{Binding ActiveTargetBorderBrush, Mode=OneWay}"
                         Fill="{Binding ActiveTargetBrush, Mode=OneWay}"
                         ToolTip="Active"/>
                <Ellipse Stroke="{Binding CompletedTargetBorderBrush, Mode=OneWay}"
                         Fill="{Binding Background, Mode=OneWay}"
                         ToolTip="Completed"/>
                <Label>Initial</Label>
                <Label>Active</Label>
                <Label>Done</Label>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>
