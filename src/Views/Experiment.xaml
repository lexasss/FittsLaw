<Page x:Class="FittsLaw.Views.Experiment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:FittsLaw.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      d:DesignWidth="800"
      Focusable="True"
      Title="Experiment"
      Loaded="Page_Loaded">
    
    <Page.DataContext>
        <vm:Experiment />
    </Page.DataContext>
    
    <Page.InputBindings>
        <KeyBinding Key="Esc" 
                    Command="{Binding InterruptCommand}" />
        <KeyBinding Key="Return" 
                    Command="{Binding ContinueCommand}" />
    </Page.InputBindings>

    <Grid>
        <ItemsControl x:Name="itemsControl"
                      ItemsSource="{Binding Targets}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="{Binding ParentSize}"
                      Height="{Binding ParentSize}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Label Content="Press ENTER to continue"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{Binding InstructionVisibility}"
               FontSize="26"/>
    </Grid>
</Page>
