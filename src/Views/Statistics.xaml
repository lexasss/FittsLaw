<Window x:Class="FittsLaw.Views.Statistics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FittsLaw.ViewModels"
        xmlns:conv="clr-namespace:FittsLaw.Converters"
        xmlns:ctrl="clr-namespace:FittsLaw.Controls"
        mc:Ignorable="d"
        Title="Statistics"
        Height="450"
        Width="500"
        MinWidth="300"
        MaxWidth="1260"
        Icon="/Assets/Images/icon.png"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Width">
    <Window.Resources>
        <conv:StatKeyToMargin x:Key="StatKeyToMargin"/>

        <DataTemplate x:Key="CopySign">
            <Grid>
                <TextBlock Margin="-2,-2,0,0" Foreground="White">▮</TextBlock>
                <TextBlock Margin="-2,-2,0,0">▯</TextBlock>
                <TextBlock Margin="2,2,0,0" Foreground="White">▮</TextBlock>
                <TextBlock Margin="2,2,0,0" >▯</TextBlock>
            </Grid>
        </DataTemplate>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="2,0,0,0"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>

        <Style x:Key="Copy" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="ContentTemplate" Value="{StaticResource CopySign}" />
        </Style>

        <Style x:Key="Save" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="💾"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="CopyPlot" TargetType="Button" BasedOn="{StaticResource Copy}">
            <Setter Property="Command" Value="{Binding CopyPlotToClipboardCommand}"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock>Copy the plot to the clipboard as an image.</TextBlock>
                            <TextBlock>Keep Control button to rather copy as HTML image.</TextBlock>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CopiedLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Visibility" Value="{Binding CopyToClipboardConfirmationVisibility}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl>
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Table">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="{Binding Key, Converter={StaticResource StatKeyToMargin}}">
                                        <WrapPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                            </Style>
                                        </WrapPanel.Resources>
                                        <TextBlock Text="{Binding Key}"
                                                   Width="128" />
                                        <ItemsControl ItemsSource="{Binding Value}"
                                                      Margin="8,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel VerticalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Width="50"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="1">
                        <WrapPanel Margin="4"
                                   HorizontalAlignment="Center">
                            <Button Style="{StaticResource Copy}"
                                    Command="{Binding CopyTableToClipboardCommand}">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock>Copy all numeric data to the clipboard.</TextBlock>
                                            <TextBlock>Keep Control button to include headers.</TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                            <Button Style="{StaticResource Save}"
                                    Margin="4,0,0,0"
                                    Command="{Binding SaveRawDataToFileCommand}"
                                    ToolTip="Save all numeric data to a file"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="TP+MT">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0"
                                    Content="{Binding TpAndMt, Mode=OneTime}"
                                    Width="500"/>
                    <Grid Grid.Row="1">
                        <WrapPanel Margin="4"
                                   HorizontalAlignment="Center">
                            <Button Style="{StaticResource CopyPlot}"
                                    CommandParameter="{Binding TpAndMt}"/>
                            <Button Style="{StaticResource Save}"
                                    Margin="4,0,0,0"
                                    Command="{Binding SavePlotToFileCommand}"
                                    CommandParameter="{Binding TpAndMt}"
                                    ToolTip="Save the plot to a file">
                            </Button>
                        </WrapPanel>
                        <Label Style="{StaticResource CopiedLabel}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="TPe+MT">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0"
                                    Content="{Binding EffTpAndMt, Mode=OneTime}"
                                    Width="500"/>
                    <Grid Grid.Row="1">
                        <WrapPanel Margin="4"
                                   HorizontalAlignment="Center">
                            <Button Style="{StaticResource CopyPlot}"
                                    CommandParameter="{Binding EffTpAndMt}"/>
                            <Button Style="{StaticResource Save}"
                                    Margin="4,0,0,0"
                                    Command="{Binding SavePlotToFileCommand}"
                                    CommandParameter="{Binding EffTpAndMt}"
                                    ToolTip="Save the plot to a file">
                            </Button>
                        </WrapPanel>
                        <Label Style="{StaticResource CopiedLabel}"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Label Style="{StaticResource CopiedLabel}"
               Content="{Binding ActionName}"/>
        
        <ctrl:Hyperlink Text="Log folder"
                        Uri="{Binding LogFolder}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"/>
    </Grid>
</Window>
